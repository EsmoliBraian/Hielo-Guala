# Postgres
POSTGRES_USER=hielo_guala
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hielo_guala
DATABASE_URL=postgresql://hielo_guala:changeme@postgres:5432/hielo_guala

# Backend
PORT=3000

# Frontend
# Vacío a propósito: el frontend llama a rutas relativas /api, que el dev
# server de Vite redirige internamente al backend (ver frontend/vite.config.ts).
# Así funciona igual desde localhost o desde el celular del repartidor en la
# misma red Wi-Fi, sin depender de que "backend" resuelva fuera de Docker.
VITE_API_BASE_URL=

# n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
TZ=America/Argentina/Buenos_Aires

# WhatsApp Cloud API (Meta)
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=changeme-verify-token
