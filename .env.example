# Postgres
POSTGRES_USER=hielo_guala
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hielo_guala
DATABASE_URL=postgresql://hielo_guala:changeme@postgres:5432/hielo_guala

# Backend
PORT=3000

# Frontend
# Vacío a propósito: el frontend llama a rutas relativas /api, que el dev
# server de Vite redirige internamente al backend (ver frontend/vite.config.ts).
# Así funciona igual desde localhost o desde el celular del repartidor en la
# misma red Wi-Fi, sin depender de que "backend" resuelva fuera de Docker.
VITE_API_BASE_URL=

# n8n
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme
# Local dev: localhost / http://localhost:5678/
# Producción: subdominios sslip.io detrás de Caddy (ver Caddyfile), ej:
#   N8N_HOST=n8n.65-21-250-228.sslip.io
#   WEBHOOK_URL=https://n8n.65-21-250-228.sslip.io/
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Argentina/Buenos_Aires
TZ=America/Argentina/Buenos_Aires

# Producción únicamente (docker-compose.prod.yml → Caddy). Dominio de la app
# web, ej: 65-21-250-228.sslip.io (mismo IP que el servidor, con guiones).
APP_DOMAIN=

# WhatsApp Cloud API (Meta) — vía oficial, requiere cuenta de Meta Business verificada
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=changeme-verify-token

# Evolution API — alternativa NO oficial (conexión por QR, como WhatsApp Web).
# Ver n8n/README.md antes de usarla: hay riesgo de que Meta banee el número.
EVOLUTION_API_KEY=changeme-evolution-api-key
EVOLUTION_INSTANCE_NAME=hielo-guala
EVOLUTION_POSTGRES_USER=evolution
EVOLUTION_POSTGRES_PASSWORD=changeme
EVOLUTION_POSTGRES_DB=evolution_db
