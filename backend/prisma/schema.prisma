generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus {
  PENDING
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
  DEBT
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

model Product {
  id         String         @id @default(cuid())
  name       String         @unique
  weightKg   Int
  price      Decimal        @db.Decimal(10, 2)
  active     Boolean        @default(true)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  aliases    ProductAlias[]
  orderItems OrderItem[]
  saleItems  SaleItem[]
}

model ProductAlias {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  alias     String   @unique
  createdAt DateTime @default(now())

  @@index([productId])
}

model Order {
  id                 String      @id @default(cuid())
  customerPhone      String
  rawMessage         String
  receivedAt         DateTime
  status             OrderStatus @default(PENDING)
  botAnswered        Boolean     @default(false)
  botAnswerError     String?
  waMessageId        String?     @unique
  deliveredAt        DateTime?
  deliveryAddress    String?
  /// Set when the bot asks for the delivery address; while this is recent and
  /// confirmedAt is still null, the next WhatsApp message from the same phone
  /// is read as part of this same order (more items, the address, or "Confirmar")
  /// instead of starting a new one.
  addressRequestedAt DateTime?
  /// Set once the customer replies "Confirmar" — closes the conversation so the
  /// next message always starts a fresh order instead of being appended here.
  confirmedAt        DateTime?
  customerId         String?
  customer           Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  items              OrderItem[]
  sale               Sale?

  @@index([status, receivedAt])
  @@index([customerPhone, receivedAt])
  @@index([customerId])
}

model Customer {
  id        String          @id @default(cuid())
  name      String
  notes     String?
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  phones    CustomerPhone[]
  orders    Order[]
}

model CustomerPhone {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  phone      String   @unique
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  rawFragment String
  quantity    Int
  matched     Boolean  @default(true)

  @@index([orderId])
}

model Sale {
  id             String         @id @default(cuid())
  orderId        String         @unique
  order          Order          @relation(fields: [orderId], references: [id])
  deliveredAt    DateTime       @default(now())
  /// Final amount actually owed/charged, after any discount.
  totalAmount    Decimal        @db.Decimal(10, 2)
  /// Pre-discount sum of line items. Null = no discount was tracked (legacy sale or no discount applied).
  subtotalAmount Decimal?       @db.Decimal(10, 2)
  discountType   DiscountType?
  discountValue  Decimal?       @db.Decimal(10, 2)
  /// Null for sales delivered before this field existed.
  paymentMethod  PaymentMethod?
  /// Only meaningful when paymentMethod = DEBT. Null while the debt is still unpaid.
  debtSettledAt  DateTime?
  createdAt      DateTime       @default(now())
  items          SaleItem[]
}

model SaleItem {
  id                  String   @id @default(cuid())
  saleId              String
  sale                Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product? @relation(fields: [productId], references: [id])
  productNameSnapshot String
  quantity            Int
  unitPriceSnapshot   Decimal  @db.Decimal(10, 2)
  lineTotal           Decimal  @db.Decimal(10, 2)

  @@index([saleId])
}
